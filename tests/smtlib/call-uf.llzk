// RUN: split-file %s %t
// Each section runs independently so SMT declarations and unsupported diagnostics
// cannot leak between cases. Use split-file because lleq has no split-input flag.
// RUN: lleq wp --struct Top %t/chain.llzk > %t/chain.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/chain.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/chain.llzk
// RUN: lleq wp --struct Top %t/distinct.llzk > %t/distinct.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/distinct.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/distinct.llzk
// RUN: lleq wp --struct Top %t/effectful.llzk 2>&1 | FileCheck %t/effectful.llzk
// RUN: lleq wp --struct Top %t/equal.llzk > %t/equal.llzk.smt2
// RUN: FileCheck %t/equal.llzk --check-prefix=SMT < %t/equal.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/equal.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/equal.llzk
// RUN: lleq wp --struct Top %t/modular.llzk > %t/modular.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/modular.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/modular.llzk
// RUN: lleq wp --struct Top %t/precondition.llzk > %t/precondition.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/precondition.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/precondition.llzk
// RUN: lleq wp --struct Top %t/scoped-callees.llzk > %t/scoped-callees.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/scoped-callees.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/scoped-callees.llzk
// RUN: lleq wp --struct Top %t/single-result.llzk > %t/single-result.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/single-result.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/single-result.llzk
// RUN: lleq wp --struct Top %t/swapped.llzk > %t/swapped.llzk.smt2
// RUN: sed '/^(get-model)$/d' %t/swapped.llzk.smt2 | "$LLEQ_Z3" -in | FileCheck %t/swapped.llzk
