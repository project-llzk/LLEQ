//--- distinct.llzk
// CHECK: {{^sat$}}
// Direct product fixture isolates native free-function UF encoding.
module attributes {llzk.lang} {
  function.def @F(%x: !felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {
    %one = felt.const 1 : <"bn254">
    %y = felt.add %x, %one : !felt.type<"bn254">, !felt.type<"bn254">
    function.return %x, %y : !felt.type<"bn254">, !felt.type<"bn254">
  }
  function.def @G(%x: !felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {
    %one = felt.const 2 : <"bn254">
    %y = felt.add %x, %one : !felt.type<"bn254">, !felt.type<"bn254">
    function.return %x, %y : !felt.type<"bn254">, !felt.type<"bn254">
  }
  struct.def @Top {
    struct.member @out0 : !felt.type<"bn254">
    struct.member @out1 : !felt.type<"bn254">
    function.def @product(%a: !felt.type<"bn254">, %b: !felt.type<"bn254">) -> !struct.type<@Top> attributes {function.allow_witness, function.allow_constraint} {
      %self = struct.new : <@Top> {product_source = "compute"}
      %w:2 = function.call @F(%a) : (!felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {product_source = "compute"}
      struct.writem %self[@out0] = %w#0 : <@Top>, !felt.type<"bn254"> {product_source = "compute"}
      struct.writem %self[@out1] = %w#1 : <@Top>, !felt.type<"bn254"> {product_source = "compute"}
      %c:2 = function.call @G(%a) : (!felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {product_source = "constrain"}
      %r0 = struct.readm %self[@out0] : <@Top>, !felt.type<"bn254"> {product_source = "constrain"}
      %r1 = struct.readm %self[@out1] : <@Top>, !felt.type<"bn254"> {product_source = "constrain"}
      %n0 = felt.neg %c#0 : !felt.type<"bn254">
      %n1 = felt.neg %c#1 : !felt.type<"bn254">
      %d0 = felt.add %r0, %n0 : !felt.type<"bn254">, !felt.type<"bn254">
      %d1 = felt.add %r1, %n1 : !felt.type<"bn254">, !felt.type<"bn254">
      %zero = felt.const 0 : <"bn254">
      constrain.eq %d0, %zero : !felt.type<"bn254">, !felt.type<"bn254">
      constrain.eq %d1, %zero : !felt.type<"bn254">, !felt.type<"bn254">
      function.return %self : !struct.type<@Top>
    }
  }
}

//--- effectful.llzk
// CHECK: Unsupported: free-function UF encoding requires a total straight-line field function
// Direct product fixture isolates native free-function UF encoding.
module attributes {llzk.lang} {
  function.def @F(%x: !felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) attributes {function.allow_constraint} {
    %one = felt.const 1 : <"bn254">
    %y = felt.add %x, %one : !felt.type<"bn254">, !felt.type<"bn254">
    constrain.eq %x, %one : !felt.type<"bn254">, !felt.type<"bn254">
    function.return %x, %y : !felt.type<"bn254">, !felt.type<"bn254">
  }
  struct.def @Top {
    struct.member @out0 : !felt.type<"bn254">
    struct.member @out1 : !felt.type<"bn254">
    function.def @product(%a: !felt.type<"bn254">, %b: !felt.type<"bn254">) -> !struct.type<@Top> attributes {function.allow_witness, function.allow_constraint} {
      %self = struct.new : <@Top> {product_source = "compute"}
      %w:2 = function.call @F(%a) : (!felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {product_source = "compute"}
      struct.writem %self[@out0] = %w#0 : <@Top>, !felt.type<"bn254"> {product_source = "compute"}
      struct.writem %self[@out1] = %w#1 : <@Top>, !felt.type<"bn254"> {product_source = "compute"}
      %c:2 = function.call @F(%a) : (!felt.type<"bn254">) -> (!felt.type<"bn254">, !felt.type<"bn254">) {product_source = "constrain"}
      %r0 = struct.readm %self[@out0] : <@Top>, !felt.type<"bn254"> {product_source = "constrain"}
      %r1 = struct.readm %self[@out1] : <@Top>, !felt.type<"bn254"> {product_source = "constrain"}
      %n0 = felt.neg %c#0 : !felt.type<"bn254">
      %n1 = felt.neg %c#1 : !felt.type<"bn254">
      %d0 = felt.add %r0, %n0 : !felt.type<"bn254">, !felt.type<"bn254">
      %d1 = felt.add %r1, %n1 : !felt.type<"bn254">, !felt.type<"bn254">
      %zero = felt.const 0 : <"bn254">
      constrain.eq %d0, %zero : !felt.type<"bn254">, !felt.type<"bn254">
      constrain.eq %d1, %zero : !felt.type<"bn254">, !felt.type<"bn254">
      function.return %self : !struct.type<@Top>
    }
  }
}

