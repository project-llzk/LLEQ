// RUN: lleq dump-store --struct Reduce %s | FileCheck --enable-var-scope %s
// XFAIL: *
// Should pass once loop fusion is merged

module attributes {llzk.lang} {
    poly.template @ReduceTemplate {
        poly.param @N

        struct.def @Reduce {
            struct.member @sum : !felt.type

            function.def @compute(%vals: !array.type<@N x !felt.type>) -> !struct.type<@ReduceTemplate::@Reduce<[@N]>> {
                %self = struct.new : <@ReduceTemplate::@Reduce<[@N]>>
                %N = poly.read_const @N : index
                %c0 = arith.constant 0 : index
                %c1 = arith.constant 1 : index
                %sum0 = felt.const 0

                %sum = scf.for %i = %c0 to %N step %c1 iter_args(%iter_sum = %sum0) -> !felt.type {
                    %val_i = array.read %vals[%i] : !array.type<@N x !felt.type>, !felt.type
                    %new_sum = felt.add %iter_sum, %val_i
                    scf.yield %new_sum : !felt.type
                }

                struct.writem %self[@sum] = %sum : !struct.type<@ReduceTemplate::@Reduce<[@N]>>, !felt.type
                function.return %self : !struct.type<@ReduceTemplate::@Reduce<[@N]>>
            }
            function.def @constrain(%self: !struct.type<@ReduceTemplate::@Reduce<[@N]>>, %vals: !array.type<@N x !felt.type>) {
                %N = poly.read_const @N : index
                %c0 = arith.constant 0 : index
                %c1 = arith.constant 1 : index
                %sum0 = felt.const 0

                %sum = scf.for %i = %c0 to %N step %c1 iter_args(%iter_sum = %sum0) -> !felt.type {
                    %val_i = array.read %vals[%i] : !array.type<@N x !felt.type>, !felt.type
                    %new_sum = felt.add %iter_sum, %val_i
                    scf.yield %new_sum : !felt.type
                }

                %written_sum = struct.readm %self[@sum] : <@ReduceTemplate::@Reduce<[@N]>>, !felt.type
                constrain.eq %written_sum, %sum : !felt.type

                function.return
            }
        }
    }
}

// CHECK-DAG: sum_w: ?1
// CHECK-DAG: sum_c: ?1
