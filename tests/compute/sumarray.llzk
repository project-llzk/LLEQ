// RUN: lleq dump-store --struct SumArr %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
    poly.template @SumArrTemplate {
        poly.param @N : index

        struct.def @SumArr {
            struct.member @sum : !array.type<@N x !felt.type>

            function.def @compute(%a: !array.type<@N x !felt.type>, %b: !array.type<@N x !felt.type>) -> !struct.type<@SumArrTemplate::@SumArr<[@N]>> {
                %self = struct.new : <@SumArrTemplate::@SumArr<[@N]>>
                %N = poly.read_const @N : index
                %c0 = arith.constant 0 : index
                %c1 = arith.constant 1 : index

                %sum = array.new : <@N x !felt.type>
                scf.for %i = %c0 to %N step %c1 {
                    %a_i = array.read %a[%i] : !array.type<@N x !felt.type>, !felt.type
                    %b_i = array.read %b[%i] : !array.type<@N x !felt.type>, !felt.type
                    %c_i = felt.add %a_i, %b_i
                    array.write %sum[%i] = %c_i : !array.type<@N x !felt.type>, !felt.type
                    scf.yield
                }

                struct.writem %self[@sum] = %sum : !struct.type<@SumArrTemplate::@SumArr<[@N]>>, !array.type<@N x !felt.type>
                function.return %self : !struct.type<@SumArrTemplate::@SumArr<[@N]>>
            }
            function.def @constrain(%self: !struct.type<@SumArrTemplate::@SumArr<[@N]>>, %a: !array.type<@N x !felt.type>, %b: !array.type<@N x !felt.type>) {
                function.return
            }
        }
    }
}

// CHECK: sum_w[?0]: felt.add(%arg0[?0], %arg1[?0])
