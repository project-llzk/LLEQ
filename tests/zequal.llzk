module attributes {veridise.lang = "llzk"} {
    
    struct.def @Num2Bits<[@N]> {
        function.def private @compute(%num: !felt.type) -> !struct.type<@Num2Bits<[@N]>>
        function.def private @constrain(%self: !struct.type<@Num2Bits<[@N]>>, %num: !felt.type)
    }

    struct.def @DecomposeProduct<[@N]> {
        struct.field @u16s : !array.type<@N x !felt.type>
        struct.field @high : !array.type<@N x !felt.type> {llzk.pub}
        struct.field @low : !array.type<@N x !felt.type> {llzk.pub}
        struct.field @bits_low : !array.type<@N x !struct.type<@Num2Bits<[8]>>>
        struct.field @bits_high : !array.type<@N x !struct.type<@Num2Bits<[8]>>>

        function.def @compute(%u8xs: !array.type<@N x !felt.type>, %u8ys: !array.type<@N x !felt.type>) -> !struct.type<@DecomposeProduct<[@N]>> {
            %self = struct.new : !struct.type<@DecomposeProduct<[@N]>>

            %c0 = arith.constant 0 : index
            %c1 = arith.constant 1 : index
            %cN = poly.read_const @N : index

            %u16s = struct.readf %self[@u16s] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %low = struct.readf %self[@low] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %bits_low = struct.readf %self[@bits_low] : <@DecomposeProduct<[@N]>>, !array.type<@N x !struct.type<@Num2Bits<[8]>>>
            %high = struct.readf %self[@high] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %bits_high = struct.readf %self[@bits_high] : <@DecomposeProduct<[@N]>>, !array.type<@N x !struct.type<@Num2Bits<[8]>>>

            scf.for %i = %c0 to %cN step %c1 {
                // u16s[i] <== u8_xs[i] * u8_ys[i];
                %xs_i = array.read %u8xs[%i] : !array.type<@N x !felt.type>, !felt.type
                %ys_i = array.read %u8ys[%i] : !array.type<@N x !felt.type>, !felt.type
                %0 = felt.mul %xs_i, %ys_i
                array.write %u16s[%i] = %0 : !array.type<@N x !felt.type>, !felt.type

                // low[i] <-- u16s[i] % 0x100
                %c0x100 = felt.const 256
                %u16s_i = array.read %u16s[%i] : !array.type<@N x !felt.type>, !felt.type
                %1 = felt.mod %u16s_i, %c0x100
                array.write %low[%i] = %1 : !array.type<@N x !felt.type>, !felt.type

                // bits_low[i] = Num2Bits(8);
                // bits_low[i].in <== low[i];
                %low_i = array.read %low[%i] : !array.type<@N x !felt.type>, !felt.type
                %bits_low_i = function.call @Num2Bits::@compute(%low_i) : (!felt.type) -> !struct.type<@Num2Bits<[8]>>
                array.write %bits_low[%i] = %bits_low_i : !array.type<@N x !struct.type<@Num2Bits<[8]>>>, !struct.type<@Num2Bits<[8]>>

                // high[i] <-- (u16s[i] \ 0x100) % 0x100;
                %2 = felt.div %u16s_i, %c0x100
                %3 = felt.mod %2, %c0x100
                array.write %high[%i] = %3 : !array.type<@N x !felt.type>, !felt.type

                // bits_high[i] = Num2Bits(8);
                // bits_high[i].in <== high[i];
                %high_i = array.read %low[%i] : !array.type<@N x !felt.type>, !felt.type
                %bits_high_i = function.call @Num2Bits::@compute(%high_i) : (!felt.type) -> !struct.type<@Num2Bits<[8]>>
                array.write %bits_high[%i] = %bits_high_i : !array.type<@N x !struct.type<@Num2Bits<[8]>>>, !struct.type<@Num2Bits<[8]>>

                // u16s[i] === low[i] + 0x100 * high[i];

                scf.yield
            }

            function.return %self : !struct.type<@DecomposeProduct<[@N]>>
        }

        function.def @constrain(%self: !struct.type<@DecomposeProduct<[@N]>>, %u8xs: !array.type<@N x !felt.type>, %u8ys: !array.type<@N x !felt.type>) {
            %c0 = arith.constant 0 : index
            %c1 = arith.constant 1 : index
            %cN = poly.read_const @N : index

            %u16s = struct.readf %self[@u16s] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %low = struct.readf %self[@low] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %bits_low = struct.readf %self[@bits_low] : <@DecomposeProduct<[@N]>>, !array.type<@N x !struct.type<@Num2Bits<[8]>>>
            %high = struct.readf %self[@high] : <@DecomposeProduct<[@N]>>, !array.type<@N x !felt.type>
            %bits_high = struct.readf %self[@bits_high] : <@DecomposeProduct<[@N]>>, !array.type<@N x !struct.type<@Num2Bits<[8]>>>

            scf.for %i = %c0 to %cN step %c1 {
                // u16s[i] <== u8_xs[i] * u8_ys[i];
                %xs_i = array.read %u8xs[%i] : !array.type<@N x !felt.type>, !felt.type
                %ys_i = array.read %u8ys[%i] : !array.type<@N x !felt.type>, !felt.type
                %0 = felt.mul %xs_i, %ys_i
                %u16s_i = array.read %u16s[%i] : !array.type<@N x !felt.type>, !felt.type
                constrain.eq %u16s_i, %0 : !felt.type

                // low[i] <-- u16s[i] % 0x100

                // bits_low[i] = Num2Bits(8);
                // bits_low[i].in <== low[i];
                %low_i = array.read %low[%i] : !array.type<@N x !felt.type>, !felt.type
                %bits_low_i = array.read %bits_low[%i] : !array.type<@N x !struct.type<@Num2Bits<[8]>>>, !struct.type<@Num2Bits<[8]>>
                function.call @Num2Bits::@constrain(%bits_low_i, %low_i) : (!struct.type<@Num2Bits<[8]>>, !felt.type) -> ()

                // high[i] <-- (u16s[i] \ 0x100) % 0x100;
                
                // bits_high[i] = Num2Bits(8);
                // bits_high[i].in <== high[i];
                %high_i = array.read %low[%i] : !array.type<@N x !felt.type>, !felt.type
                %bits_high_i = array.read %bits_high[%i] : !array.type<@N x !struct.type<@Num2Bits<[8]>>>, !struct.type<@Num2Bits<[8]>>
                function.call @Num2Bits::@constrain(%bits_high_i, %high_i) : (!struct.type<@Num2Bits<[8]>>, !felt.type) -> ()

                // u16s[i] === low[i] + 0x100 * high[i];
                %c0x100 = felt.const 256
                %1 = felt.mul %c0x100, %high_i
                %2 = felt.add %1, %low_i
                constrain.eq %2, %u16s_i : !felt.type

                scf.yield
            }

            function.return
        }
    }
}
